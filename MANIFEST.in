include README.md LICENSE CONTRIBUTING.md CHANGELOG.md uv.lock
include Dockerfile .dockerignore .gitignore .gitattributes .editorconfig
recursive-include .github *.yml
recursive-include incident_lab/data *.json
recursive-include docs *.md
recursive-include examples *.md *.json
recursive-include scripts *.py
recursive-include tests *.py
global-exclude *.pyc
prune artifacts
prune .venv
